# MiniClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
MINICLAUDE_HOST=127.0.0.1
MINICLAUDE_PORT=10721

# ── Logging ───────────────────────────────────────────────────
MINICLAUDE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
MINICLAUDE_LOG_FILE=~/.mc/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
MINICLAUDE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# MINICLAUDE_CONFIG=~/.mc/config.toml

# ── Trace ───────────────────────────────────────────────
MINICLAUDE_TRACE_ENABLED=false
MINICLAUDE_TRACE_FILE=~/.mc/logs/trace.jsonl
MINICLAUDE_TRACE_INCLUDE_LLM_PAYLOAD=false  

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# MINICLAUDE_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# MINICLAUDE_MAX_STEPS=20

# ── Sandbox ───────────────────────────────────────────────────
# Bash 工具的操作系统级隔离模式：
#   off       不隔离（仅权限审批）
#   workspace 写操作限定在工作区内（默认；需 macOS sandbox-exec 或 Linux bwrap）
#   strict    在 workspace 基础上禁止网络访问
MINICLAUDE_SANDBOX_MODE=workspace
# 额外可写/可读路径通过配置文件 [sandbox] allow_write / allow_read 配置
