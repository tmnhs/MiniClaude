# MiniClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改
#
# 加载与优先级（高 → 低）：
#   1. 系统环境变量
#   2. .env（项目根目录 .env，其次 ~/.mc/.env；不覆盖已存在的变量）
#   3. 配置文件（~/.mc/config.toml，其次 ./.mc/config.toml；或 MINICLAUDE_CONFIG 指定）
#   4. 内置默认值
# MINICLAUDE_* 变量用于覆盖 config.toml 中对应字段；注释掉的项表示使用默认值。

# ── Core Daemon ───────────────────────────────────────────────
# daemon 与 CLI/TUI 通信的 TCP loopback 地址
MINICLAUDE_HOST=127.0.0.1
MINICLAUDE_PORT=10721

# ── Config File ───────────────────────────────────────────────
# 显式指定配置文件；设置后只读该文件，不再叠加 ~/.mc 与项目级 config.toml
# MINICLAUDE_CONFIG=~/.mc/config.toml

# ── Logging（mc-core daemon） ─────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
MINICLAUDE_LOG_LEVEL=INFO
# 滚动日志文件；留空则仅输出 stderr
MINICLAUDE_LOG_FILE=~/.mc/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
MINICLAUDE_LOG_FORMAT=text

# ── Logging（mc-tui） ─────────────────────────────────────────
# TUI 日志写入滚动文件（不写 stderr，避免干扰界面渲染）
# MINICLAUDE_TUI_LOG_FILE=~/.mc/logs/tui.log

# ── LLM ───────────────────────────────────────────────────────
# Anthropic API Key（必填；缺失时 daemon 启动即报错）
# ANTHROPIC_API_KEY=sk-ant-...
# 自定义 API 端点（SDK 透传，用于代理或兼容 Anthropic 协议的服务）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 默认模型
# MINICLAUDE_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# 单次 run 的最大 agent 步数（正整数）
# MINICLAUDE_MAX_STEPS=20

# ── Permission ────────────────────────────────────────────────
# 权限审批超时秒数；0 表示不超时
# MINICLAUDE_PERMISSION_TIMEOUT_S=60

# ── Trace ─────────────────────────────────────────────────────
MINICLAUDE_TRACE_ENABLED=false
MINICLAUDE_TRACE_FILE=~/.mc/logs/trace.jsonl
# 是否在 trace 中包含完整 LLM 请求/响应（体积大且可能含敏感内容）
MINICLAUDE_TRACE_INCLUDE_LLM_PAYLOAD=false

# ── Compaction（上下文压缩） ──────────────────────────────────
# context 使用率超过该比例时自动压缩；0 表示禁用（推荐手动 /compact）
# MINICLAUDE_COMPACT_THRESHOLD=0.0
# 单个 tool_result 超过该字符数时截断
# MINICLAUDE_COMPACT_TOOL_LIMIT=8000
# 截断后保留的前缀字符数
# MINICLAUDE_COMPACT_TOOL_KEEP=4000

# ── Sandbox ───────────────────────────────────────────────────
# Bash 工具的操作系统级隔离模式：
#   off       不隔离（仅权限审批）
#   workspace 写操作限定在工作区内（默认；需 macOS sandbox-exec 或 Linux bwrap）
#   strict    在 workspace 基础上禁止网络访问
MINICLAUDE_SANDBOX_MODE=workspace
# 额外可写/可读路径仅能通过配置文件设置：
# [sandbox]
# allow_read  = ["~/.local/share/uv", "~/.cache/uv"]
# allow_write = ["~/.cache/uv"]
